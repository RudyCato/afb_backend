+</style>
+</head>
+<body>
+<main>
+  <div class="card">
+    <div class="eyebrow" id="modeLabel">Set a new password</div>
+    <h1 id="titleText">Change your password</h1>
+    <p class="sub" id="subText">You're on a shared starter password — set one only you know before continuing.</p>
+
+    <div class="error" id="err"></div>
+
+    <form id="pwForm">
+      <label for="current">Current password</label>
+      <input id="current" type="password" autocomplete="current-password" required>
+
+      <label for="new1">New password</label>
+      <input id="new1" type="password" autocomplete="new-password" required minlength="8">
+
+      <label for="new2">Confirm new password</label>
+      <input id="new2" type="password" autocomplete="new-password" required minlength="8">
+
+      <button class="btn" type="submit" id="submitBtn">Save password</button>
+    </form>
+    <div class="hint">At least 8 characters. Doesn't need to be fancy — just not the shared one.</div>
+    <div class="skip" id="skipRow" style="display:none;">
+      <a href="#" id="skipLink">Skip for now</a>
+    </div>
+  </div>
+</main>
+
+<script>
+  const params = new URLSearchParams(window.location.search);
+  const nextPath = params.get('next') || '/dashboard';
+
+  let forced = false;
+  fetch('/auth/me').then(r => r.json()).then(me => {
+    forced = !!me.must_change_password;
+    if (!forced) {
+      document.getElementById('modeLabel').textContent = 'Account settings';
+      document.getElementById('titleText').textContent = 'Change your password';
+      document.getElementById('subText').textContent = 'Update your password any time.';
+      document.getElementById('skipRow').style.display = 'block';
+    }
+  });
+
+  document.getElementById('skipLink').addEventListener('click', (e) => {
+    e.preventDefault();
+    window.location.href = nextPath;
+  });
+
+  const form = document.getElementById('pwForm');
+  const errBox = document.getElementById('err');
+  const submitBtn = document.getElementById('submitBtn');
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    errBox.style.display = 'none';
+
+    const current = document.getElementById('current').value;
+    const new1 = document.getElementById('new1').value;
+    const new2 = document.getElementById('new2').value;
+
+    if (new1 !== new2) {
+      errBox.textContent = "New passwords don't match.";
+      errBox.style.display = 'block';
+      return;
+    }
+    if (new1.length < 8) {
+      errBox.textContent = 'New password must be at least 8 characters.';
+      errBox.style.display = 'block';
+      return;
+    }
+
+    submitBtn.disabled = true;
+    submitBtn.textContent = 'Saving…';
+
+    try {
+      const res = await fetch('/auth/change-password', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json'},
+        body: JSON.stringify({current_password: current, new_password: new1})
+      });
+      if (!res.ok) {
+        const data = await res.json().catch(() => ({}));
+        errBox.textContent = data.detail || 'Could not change password.';
+        errBox.style.display = 'block';
+        submitBtn.disabled = false;
+        submitBtn.textContent = 'Save password';
+        return;
+      }
+      window.location.href = nextPath;
+    } catch (err) {
+      errBox.textContent = 'Could not reach the server. Try again.';
+      errBox.style.display = 'block';
+      submitBtn.disabled = false;
+      submitBtn.textContent = 'Save password';
+    }
+  });
+</script>
+</body>
+</html>
