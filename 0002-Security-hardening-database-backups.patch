+// ---------------- Data & Backups (admin only) ----------------
+async function initBackupPanel(){
+  try {
+    const res = await fetch('/auth/me');
+    if (!res.ok) return;
+    const me = await res.json();
+    if (me.role !== 'admin') return; // managers/packers don't see this panel
+    document.getElementById('backupSection').style.display = 'block';
+    loadBackupHistory();
+  } catch(e) { /* fail quiet — panel just stays hidden */ }
+}
+
+async function loadBackupHistory(){
+  const body = document.getElementById('backupHistoryBody');
+  try {
+    const res = await fetch('/admin/backup/history');
+    if (!res.ok) throw new Error();
+    const logs = await res.json();
+    if (!logs.length) {
+      body.innerHTML = '<tr><td colspan="6" class="mono" style="color:var(--ink-soft);">No backups yet.</td></tr>';
+      return;
+    }
+    body.innerHTML = logs.map(l => `
+      <tr>
+        <td class="mono">${new Date(l.created_at).toLocaleString()}</td>
+        <td>${l.destination}</td>
+        <td style="color:${l.status === 'success' ? 'var(--olive-deep)' : 'var(--rust-deep)'};font-weight:600;">${l.status}${l.error_message ? ' — ' + escapeHtmlLocal(l.error_message) : ''}</td>
+        <td class="mono">${l.filename || '—'}</td>
+        <td class="mono">${l.size_bytes ? (l.size_bytes/1024).toFixed(1) + ' KB' : '—'}</td>
+        <td>${l.triggered_by || '—'}</td>
+      </tr>
+    `).join('');
+  } catch(e) {
+    body.innerHTML = '<tr><td colspan="6" class="mono" style="color:var(--ink-soft);">Could not load backup history.</td></tr>';
+  }
+}
+
+async function runCloudBackup(){
+  const btn = document.getElementById('cloudBackupBtn');
+  const msgEl = document.getElementById('cloudBackupMsg');
+  btn.disabled = true;
+  const originalText = btn.textContent;
+  btn.textContent = 'Uploading…';
+  msgEl.style.display = 'none';
+
+  try {
+    const res = await fetch('/admin/backup/cloud', {method: 'POST'});
+    const data = await res.json();
+    msgEl.style.display = 'block';
+    if (data.ok) {
+      msgEl.style.background = '#e3f0d8'; msgEl.style.color = 'var(--olive-deep)';
+      msgEl.textContent = data.detail;
+    } else {
+      msgEl.style.background = '#f7dcd8'; msgEl.style.color = 'var(--rust-deep)';
+      msgEl.textContent = data.detail;
+    }
+    loadBackupHistory();
+  } catch(e) {
+    msgEl.style.display = 'block';
+    msgEl.style.background = '#f7dcd8'; msgEl.style.color = 'var(--rust-deep)';
+    msgEl.textContent = 'Could not reach the server.';
+  } finally {
+    btn.disabled = false;
+    btn.textContent = originalText;
+  }
+}
+
+// Also log a backup_logs row for the local download — since it's a plain
+// <a href> the browser handles the download itself, so we just fire a
+// quick history refresh a moment after the click.
+document.getElementById('localBackupBtn').addEventListener('click', () => {
+  setTimeout(loadBackupHistory, 1500);
+});
+
+function escapeHtmlLocal(str){
+  const d = document.createElement('div');
+  d.textContent = str || '';
+  return d.innerHTML;
+}
+
+initBackupPanel();
 loadAll();
 </script>
 
