+  *{box-sizing:border-box;}
+  body{margin:0;background:var(--kraft);color:var(--espresso);font-family:'Inter',sans-serif;
+    min-height:100vh;display:flex;flex-direction:column;}
+  h1{font-family:'Fraunces',serif;margin:0;}
+  main{flex:1;display:flex;align-items:center;justify-content:center;padding:24px;}
+  .card{background:var(--paper);border:2px solid var(--espresso);border-radius:3px;box-shadow:var(--shadow);
+    padding:40px 36px;width:100%;max-width:420px;}
+  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;
+    color:var(--amber-deep);font-weight:600;margin-bottom:8px;}
+  .card h1{font-size:1.6rem;font-weight:800;margin-bottom:6px;}
+  .card p.sub{color:var(--espresso-soft);font-size:0.9rem;margin:0 0 26px;line-height:1.5;}
+  label{display:block;font-size:0.8rem;font-weight:600;margin-bottom:6px;color:var(--espresso-soft);}
+  input{width:100%;padding:12px 14px;border:2px solid var(--line);border-radius:2px;font-size:0.98rem;
+    background:#fff;color:var(--espresso);margin-bottom:16px;}
+  input:focus{outline:none;border-color:var(--espresso);}
+  .btn{width:100%;font-family:'IBM Plex Mono',monospace;font-size:0.85rem;text-transform:uppercase;
+    letter-spacing:0.05em;padding:14px 24px;border-radius:2px;border:2px solid var(--espresso);
+    background:var(--espresso);color:var(--paper);font-weight:600;cursor:pointer;}
+  .btn:hover{background:var(--forest);border-color:var(--forest);}
