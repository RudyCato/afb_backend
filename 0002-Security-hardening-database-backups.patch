+  .error{background:#fbeceb;border:1.5px solid var(--cranberry);color:var(--cranberry);padding:10px 14px;
+    border-radius:2px;font-size:0.85rem;margin-bottom:16px;display:none;}
+  .hint{margin-top:16px;font-size:0.78rem;color:var(--espresso-soft);}
