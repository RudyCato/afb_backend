-async function lookupOrder(orderNumber){
-  document.getElementById('trackInput').value = orderNumber;
-  const result = document.getElementById('trackResult');
-  result.innerHTML = `<div class="loading">Looking up ${orderNumber}…</div>`;
-  try{
-    const order = await api('/orders/' + encodeURIComponent(orderNumber));
