+  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
+  .modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}
+
+  .notes-input{width:160px;}
+  .loading, .empty{color:var(--ink-soft);font-style:italic;padding:16px;}
+</style>
+</head>
+<body>
+
+<header>
+  <div class="wrap">
+    <div>
+      <div class="top">American Food &amp; Beverage</div>
+      <div class="bottom">Careers Admin</div>
+    </div>
+    <div style="display:flex;align-items:center;gap:14px;">
+      <a href="/dashboard" class="nav-link">&larr; Dashboard</a>
+      <span id="whoami" class="mono" style="font-size:0.75rem;"></span>
+      <a href="#" class="nav-link" onclick="logout();return false;">Log out</a>
+    </div>
+  </div>
+</header>
+
+<div class="wrap">
+
+  <div class="kpi-row" id="kpiRow"></div>
+
+  <div class="tabs">
+    <div class="tab active" data-tab="applications">Applications</div>
+    <div class="tab" data-tab="jobs">Job postings</div>
+  </div>
+
+  <!-- ============ Applications tab ============ -->
+  <div class="tab-panel active" data-panel="applications">
+    <div class="filter-row" id="statusFilters">
+      <div class="filter-chip active" data-status="all">All</div>
+      <div class="filter-chip" data-status="new">New</div>
+      <div class="filter-chip" data-status="reviewing">Reviewing</div>
+      <div class="filter-chip" data-status="interview">Interview</div>
+      <div class="filter-chip" data-status="hired">Hired</div>
+      <div class="filter-chip" data-status="declined">Declined</div>
+    </div>
+    <div id="appsTableWrap"><div class="loading">Loading applications&hellip;</div></div>
+  </div>
+
+  <!-- ============ Jobs tab ============ -->
+  <div class="tab-panel" data-panel="jobs">
+    <div style="margin-bottom:16px;">
+      <button class="btn" onclick="openJobModal()">+ New posting</button>
+    </div>
+    <div id="jobsList"><div class="loading">Loading job postings&hellip;</div></div>
+  </div>
+
+</div>
+
+<!-- ============ Job posting create/edit modal ============ -->
+<div class="modal-overlay" id="jobModalOverlay">
+  <div class="modal-box">
+    <h3 id="jobModalTitle">New job posting</h3>
+    <div class="field">
+      <label>Title</label>
+      <input id="j_title">
+    </div>
+    <div class="field-row">
+      <div class="field">
+        <label>Department</label>
+        <input id="j_department">
+      </div>
+      <div class="field">
+        <label>Location</label>
+        <input id="j_location" value="Paterson, NJ">
+      </div>
+    </div>
+    <div class="field-row">
+      <div class="field">
+        <label>Shift</label>
+        <input id="j_shift">
+      </div>
+      <div class="field">
+        <label>Pay range</label>
+        <input id="j_pay_range" placeholder="e.g. $19-23/hr">
+      </div>
+    </div>
+    <div class="field">
+      <label>Summary</label>
+      <textarea id="j_summary"></textarea>
+    </div>
+    <div class="field">
+      <label>Requirements (one per line)</label>
+      <textarea id="j_requirements"></textarea>
+    </div>
+    <div class="field" id="j_status_field" style="display:none;">
+      <label>Status</label>
+      <select id="j_status">
+        <option value="open">Open</option>
+        <option value="closed">Closed</option>
+      </select>
+    </div>
+    <div class="modal-actions">
+      <button class="btn btn-outline" onclick="closeJobModal()">Cancel</button>
+      <button class="btn" id="jobSaveBtn" onclick="saveJob()">Save posting</button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STATUS_OPTIONS = ['new', 'reviewing', 'interview', 'hired', 'declined'];
+  let applications = [];
+  let jobs = [];
+  let activeStatusFilter = 'all';
+  let editingJobId = null;
+
+  async function checkAuth() {
+    const res = await fetch('/auth/me');
+    if (!res.ok) { window.location.href = '/login?next=/careers-admin'; return; }
+    const me = await res.json();
+    document.getElementById('whoami').textContent = `${me.full_name} (${me.role})`;
+  }
+
+  function logout() {
+    fetch('/auth/logout', {method: 'POST'}).then(() => window.location.href = '/login');
+  }
+
+  // ---------------- Tabs ----------------
+  document.querySelectorAll('.tab').forEach(tab => {
+    tab.addEventListener('click', () => {
+      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
+      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
+      tab.classList.add('active');
+      document.querySelector(`.tab-panel[data-panel="${tab.getAttribute('data-tab')}"]`).classList.add('active');
+    });
+  });
+
+  // ---------------- KPIs ----------------
+  function renderKpis() {
+    const total = applications.length;
+    const byStatus = {};
+    STATUS_OPTIONS.forEach(s => byStatus[s] = 0);
+    applications.forEach(a => byStatus[a.status] = (byStatus[a.status] || 0) + 1);
+    const openJobs = jobs.filter(j => j.status === 'open').length;
+
+    document.getElementById('kpiRow').innerHTML = `
+      <div class="kpi"><div class="n">${total}</div><div class="l">Total applicants</div></div>
+      <div class="kpi"><div class="n">${byStatus.new}</div><div class="l">New</div></div>
+      <div class="kpi"><div class="n">${byStatus.interview}</div><div class="l">Interviewing</div></div>
+      <div class="kpi"><div class="n">${byStatus.hired}</div><div class="l">Hired</div></div>
+      <div class="kpi"><div class="n">${openJobs}</div><div class="l">Open postings</div></div>
+    `;
+  }
+
+  // ---------------- Applications ----------------
+  async function loadApplications() {
+    try {
+      const res = await fetch('/careers/applications');
+      if (!res.ok) throw new Error();
+      applications = await res.json();
+      renderApplications();
+      renderKpis();
+    } catch (e) {
+      document.getElementById('appsTableWrap').innerHTML = '<div class="empty">Could not load applications.</div>';
+    }
+  }
+
+  document.querySelectorAll('#statusFilters .filter-chip').forEach(chip => {
+    chip.addEventListener('click', () => {
+      document.querySelectorAll('#statusFilters .filter-chip').forEach(c => c.classList.remove('active'));
+      chip.classList.add('active');
+      activeStatusFilter = chip.getAttribute('data-status');
+      renderApplications();
+    });
+  });
+
+  function renderApplications() {
+    const filtered = activeStatusFilter === 'all'
+      ? applications
+      : applications.filter(a => a.status === activeStatusFilter);
+
+    if (!filtered.length) {
+      document.getElementById('appsTableWrap').innerHTML = '<div class="empty">No applications match this filter.</div>';
+      return;
+    }
+
+    const rows = filtered.map(a => `
+      <tr>
+        <td>
+          <div><strong>${escapeHtml(a.full_name)}</strong></div>
+          <div class="muted">${escapeHtml(a.phone)}${a.email ? ' &middot; ' + escapeHtml(a.email) : ''}</div>
+          <div class="muted">${escapeHtml(a.city || '')}</div>
+        </td>
+        <td>${escapeHtml(a.job_title)}</td>
+        <td class="muted">
+          ${a.availability ? escapeHtml(a.availability) : '—'}<br>
+          ${a.experience_years ? 'Exp: ' + escapeHtml(a.experience_years) : ''}
+          ${a.has_license !== null && a.has_license !== undefined ? '<br>License: ' + (a.has_license ? 'Yes' : 'No') : ''}
+        </td>
+        <td class="muted">${new Date(a.applied_at).toLocaleDateString()}</td>
+        <td>
+          <select class="status-select" onchange="updateStatus(${a.id}, this.value)">
+            ${STATUS_OPTIONS.map(s => `<option value="${s}" ${s === a.status ? 'selected' : ''}>${s}</option>`).join('')}
+          </select>
+        </td>
+        <td>
+          <input class="notes-input" placeholder="notes…" value="${escapeAttr(a.reviewer_notes || '')}"
+            onblur="updateNotes(${a.id}, this.value)">
+        </td>
+      </tr>
+    `).join('');
+
+    document.getElementById('appsTableWrap').innerHTML = `
+      <table>
+        <thead><tr><th>Applicant</th><th>Position</th><th>Details</th><th>Applied</th><th>Status</th><th>Notes</th></tr></thead>
+        <tbody>${rows}</tbody>
+      </table>
+    `;
+  }
+
+  async function updateStatus(id, status) {
+    await fetch(`/careers/applications/${id}`, {
+      method: 'PATCH', headers: {'Content-Type': 'application/json'},
+      body: JSON.stringify({status})
+    });
+    const a = applications.find(x => x.id === id);
+    if (a) a.status = status;
+    renderKpis();
+  }
+
+  async function updateNotes(id, notes) {
+    const a = applications.find(x => x.id === id);
+    await fetch(`/careers/applications/${id}`, {
+      method: 'PATCH', headers: {'Content-Type': 'application/json'},
+      body: JSON.stringify({status: a.status, reviewer_notes: notes})
+    });
+    if (a) a.reviewer_notes = notes;
+  }
+
+  // ---------------- Job postings ----------------
+  async function loadJobs() {
+    try {
+      const res = await fetch('/careers/jobs/all');
+      if (!res.ok) throw new Error();
+      jobs = await res.json();
+      renderJobs();
+      renderKpis();
+    } catch (e) {
+      document.getElementById('jobsList').innerHTML = '<div class="empty">Could not load job postings.</div>';
+    }
+  }
+
+  function renderJobs() {
+    if (!jobs.length) {
+      document.getElementById('jobsList').innerHTML = '<div class="empty">No job postings yet.</div>';
+      return;
+    }
+    document.getElementById('jobsList').innerHTML = jobs.map(j => `
+      <div class="job-card">
+        <div class="job-card-head">
+          <div>
+            <h3>${escapeHtml(j.title)}</h3>
+            <div class="job-meta">
+              ${j.department ? `<span>${escapeHtml(j.department)}</span>` : ''}
+              ${j.shift ? `<span>${escapeHtml(j.shift)}</span>` : ''}
+              ${j.pay_range ? `<span>${escapeHtml(j.pay_range)}</span>` : ''}
+              <span>${j.application_count} applicant${j.application_count === 1 ? '' : 's'}</span>
+            </div>
+          </div>
+          <span class="job-status-pill job-status-${j.status}">${j.status}</span>
+        </div>
+        <div style="margin-top:10px;display:flex;gap:8px;">
+          <button class="btn btn-outline" onclick="openJobModal(${j.id})">Edit</button>
+          ${j.status === 'open'
+            ? `<button class="btn btn-outline" onclick="toggleJobStatus(${j.id}, 'closed')">Close posting</button>`
+            : `<button class="btn btn-outline" onclick="toggleJobStatus(${j.id}, 'open')">Reopen posting</button>`}
+        </div>
+      </div>
+    `).join('');
+  }
+
+  function openJobModal(jobId) {
+    editingJobId = jobId || null;
+    const job = jobId ? jobs.find(j => j.id === jobId) : null;
+    document.getElementById('jobModalTitle').textContent = job ? 'Edit job posting' : 'New job posting';
+    document.getElementById('j_title').value = job ? job.title : '';
+    document.getElementById('j_department').value = job ? (job.department || '') : '';
+    document.getElementById('j_location').value = job ? job.location : 'Paterson, NJ';
+    document.getElementById('j_shift').value = job ? (job.shift || '') : '';
+    document.getElementById('j_pay_range').value = job ? (job.pay_range || '') : '';
+    document.getElementById('j_summary').value = job ? (job.summary || '') : '';
+    document.getElementById('j_requirements').value = job ? (job.requirements || '') : '';
+    document.getElementById('j_status_field').style.display = job ? 'block' : 'none';
+    if (job) document.getElementById('j_status').value = job.status;
+    document.getElementById('jobModalOverlay').classList.add('open');
+  }
+  function closeJobModal() {
+    document.getElementById('jobModalOverlay').classList.remove('open');
+  }
+  document.getElementById('jobModalOverlay').addEventListener('click', (e) => {
+    if (e.target.id === 'jobModalOverlay') closeJobModal();
+  });
+
+  async function saveJob() {
+    const payload = {
+      title: document.getElementById('j_title').value.trim(),
+      department: document.getElementById('j_department').value.trim() || null,
+      location: document.getElementById('j_location').value.trim() || 'Paterson, NJ',
+      shift: document.getElementById('j_shift').value.trim() || null,
+      pay_range: document.getElementById('j_pay_range').value.trim() || null,
+      summary: document.getElementById('j_summary').value.trim() || null,
+      requirements: document.getElementById('j_requirements').value.trim() || null,
+    };
+    if (!payload.title) { alert('Title is required.'); return; }
+
+    if (editingJobId) {
+      payload.status = document.getElementById('j_status').value;
+      await fetch(`/careers/jobs/${editingJobId}`, {
+        method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
+      });
+    } else {
+      await fetch('/careers/jobs', {
+        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
+      });
+    }
+    closeJobModal();
+    await loadJobs();
+  }
+
+  async function toggleJobStatus(jobId, status) {
+    await fetch(`/careers/jobs/${jobId}`, {
+      method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({status})
+    });
+    await loadJobs();
+  }
+
+  function escapeHtml(str) {
+    const d = document.createElement('div');
+    d.textContent = str || '';
+    return d.innerHTML;
+  }
+  function escapeAttr(str) {
+    return (str || '').replace(/"/g, '&quot;');
+  }
+
+  checkAuth();
+  loadApplications();
+  loadJobs();
+</script>
+
+</body>
+</html>
