-<script>
-const API = '';
-let statusChart, cycleChart;
-
-async function fetchJSON(path){
-  const res = await fetch(API + path);
-  if(!res.ok) throw new Error(path + ' failed');
-  return res.json();
-}
-function openModal(id){ document.getElementById(id).classList.add('open'); }
-function closeModal(id){ document.getElementById(id).classList.remove('open'); }
-document.querySelectorAll('.modal-backdrop').forEach(el=>{
-  el.addEventListener('click', (e)=>{ if(e.target === el) closeModal(el.id); });
-});
-
-function toggleInventory(){
-  const el = document.getElementById('inventorySection');
-  el.classList.toggle('show');
-  document.querySelector('.toggle-link').textContent =
-    el.classList.contains('show') ? '− Hide product & inventory list' : '+ View full product & inventory list';
-}
-
-async function loadAll(){
-  const statusEl = document.getElementById('apiStatus');
-  try{
-    const dash = await fetchJSON('/reports/dashboard');
-    statusEl.textContent = 'API connected';
-    statusEl.className = 'mono ok';
-    renderKPIs(dash);
-  }catch(e){
-    statusEl.textContent = 'API not reachable';
-    statusEl.className = 'mono bad';
-    return;
-  }
-
-  const [byStatus, cycle, inventory, alertsData] = await Promise.all([
-    fetchJSON('/reports/orders-by-status'),
-    fetchJSON('/reports/order-cycle-time'),
-    fetchJSON('/reports/inventory'),
-    fetchJSON('/reports/alerts'),
-  ]);
-
-  renderStatusChart(byStatus);
-  renderCycleChart(cycle);
-  renderInventory(inventory);
-  renderAlerts(alertsData);
-}
-
-function renderAlerts(data){
-  const el = document.getElementById('alertsBanner');
-  if(!data.issues.length){
-    el.className = 'show';
-    el.innerHTML = '<div class="all-clear">&#9989; No issues right now — everything is moving normally.</div>';
-    return;
-  }
