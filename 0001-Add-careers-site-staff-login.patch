-<script>
-const API = '';
-let ALL_PRODUCTS = [];
-let activeCategory = 'all';
-let visibleCount = 12;
-const PAGE_SIZE = 12;
-
-const CATEGORY_ICONS = {
-  'default':'🌰','Nuts':'🥜','Trail Mixes':'🥾','Dried Fruits & Vegetables':'🍑',
-  'Chocolate Covered Items':'🍫','Candy':'🍬','Granola':'🥣','Health Snacks':'🌱',
-  'Organic Nuts':'🌿','Grains & Beans':'🌾','Special Flavored Nuts':'✨',
-  'Dried Fruits - Organic':'🍇','Big Presentation Containers':'📦','Nuts To Go Cups':'🥤',
-};
-function iconFor(cat){ return CATEGORY_ICONS[cat] || CATEGORY_ICONS.default; }
-
-async function loadCatalog(){
-  const statusEl = document.getElementById('catalogStatus');
-  try{
-    const res = await fetch(`${API}/products?item_type=sellable`);
-    if(!res.ok) throw new Error('fetch failed');
-    ALL_PRODUCTS = await res.json();
-  }catch(e){
-    statusEl.textContent = 'Catalog is warming up — reload in a few seconds. (Hosted on a free tier that sleeps when idle.)';
-    return;
-  }
-
-  document.getElementById('statProducts').textContent = ALL_PRODUCTS.length;
-  document.getElementById('heroSkuCount').textContent = ALL_PRODUCTS.length + ' SKUs';
-
-  renderCategoryGrid();
-  renderChips();
-  renderProducts();
-}
-
-function categoryCounts(){
-  const counts = {};
-  ALL_PRODUCTS.forEach(p => { counts[p.category] = (counts[p.category]||0) + 1; });
-  return counts;
-}
-
-function renderCategoryGrid(){
-  const counts = categoryCounts();
-  const topCats = Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,8);
-  document.getElementById('categoryGrid').innerHTML = topCats.map(([cat,count])=>`
-    <div class="cat-card" onclick="filterByCategory('${cat.replace(/'/g,"\\'")}')">
-      <div class="ic">${iconFor(cat)}</div>
-      <h3>${cat}</h3>
-      <div class="count">${count} items</div>
-    </div>
-  `).join('');
-}
-
-function renderChips(){
-  const counts = categoryCounts();
-  const cats = ['all', ...Object.keys(counts).sort()];
-  document.getElementById('chipRow').innerHTML = cats.map(c=>`
-    <button class="chip ${c===activeCategory?'active':''}" onclick="filterByCategory('${c.replace(/'/g,"\\'")}')">
-      ${c === 'all' ? 'All' : c}
-    </button>
-  `).join('');
-}
-
-function filterByCategory(cat){
-  activeCategory = cat;
-  visibleCount = PAGE_SIZE;
-  document.getElementById('searchBox').value = '';
-  renderChips();
-  renderProducts();
-  document.getElementById('catalog').scrollIntoView({behavior:'smooth', block:'start'});
-}
-
-function renderProducts(){
-  const q = document.getElementById('searchBox').value.trim().toLowerCase();
-  let filtered = ALL_PRODUCTS;
-  if(activeCategory !== 'all') filtered = filtered.filter(p => p.category === activeCategory);
-  if(q) filtered = filtered.filter(p => p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q));
-
-  document.getElementById('catalogStatus').textContent = `${filtered.length} product${filtered.length===1?'':'s'} ${activeCategory!=='all' ? 'in ' + activeCategory : ''}${q ? ' matching "' + q + '"' : ''}`;
-
-  const toShow = filtered.slice(0, visibleCount);
-  document.getElementById('productGrid').innerHTML = toShow.map(p => `
-    <div class="product-card">
-      <div class="sku">${p.sku}</div>
-      <h4>${p.name}</h4>
-      <div class="pack">${p.pack_size || p.category}</div>
-    </div>
-  `).join('') || '<p style="color:var(--espresso-soft);">No products match — try a different search.</p>';
-
-  const moreBtn = document.getElementById('loadMoreBtn');
-  if(filtered.length > visibleCount){
-    moreBtn.style.display = 'block';
-    moreBtn.onclick = () => { visibleCount += PAGE_SIZE; renderProducts(); };
-  } else {
-    moreBtn.style.display = 'none';
-  }
-}
-
-document.getElementById('searchBox').addEventListener('input', () => { visibleCount = PAGE_SIZE; renderProducts(); });
-
-loadCatalog();
-</script>
-
-</body>
-</html>
