+  .job-meta span{display:flex;align-items:center;gap:5px;}
+  .job-summary{font-size:0.92rem;color:var(--espresso-soft);max-width:520px;line-height:1.5;}
+  .pay-pill{
+    font-family:'IBM Plex Mono',monospace;font-size:0.78rem;font-weight:700;color:var(--forest-deep);
+    background:var(--kraft-deep);padding:3px 9px;border-radius:2px;
+  }
+  .btn{
+    display:inline-flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:0.8rem;
+    text-transform:uppercase;letter-spacing:0.05em;padding:12px 22px;border-radius:2px;text-decoration:none;
+    font-weight:600;border:2px solid var(--espresso);cursor:pointer;white-space:nowrap;
+  }
+  .btn-solid{background:var(--espresso);color:var(--paper);}
+  .btn-solid:hover{background:var(--forest);border-color:var(--forest);}
+  .btn-outline{background:transparent;color:var(--espresso);}
+  .btn-outline:hover{background:var(--espresso);color:var(--paper);}
+  .btn:disabled{opacity:0.5;cursor:default;}
+  .loading, .empty{color:var(--espresso-soft);font-style:italic;padding:20px 0;}
+
+  /* ---------- Modal ---------- */
+  .overlay{
+    position:fixed;inset:0;background:rgba(43,29,18,0.55);z-index:100;
+    display:none;align-items:flex-start;justify-content:center;padding:32px 16px;overflow-y:auto;
+  }
+  .overlay.open{display:flex;}
+  .modal{
+    background:var(--paper);border:2px solid var(--espresso);border-radius:3px;box-shadow:var(--shadow);
