-<script>
-const API = '';   // same origin: this page is served by the same backend it talks to
-
-const STATUS_STEPS = [
-  {key:'received', label:'Order Received', icon:'📝', desc:'Your order was logged and is queued for review.'},
-  {key:'confirmed', label:'Confirmed', icon:'✔️', desc:'Our team confirmed item availability and quantities.'},
-  {key:'packing', label:'Packing', icon:'📦', desc:'Being roasted, weighed and packed at the Paterson facility.'},
-  {key:'packed', label:'Packed', icon:'✅', desc:'Fully packed and staged for shipment.'},
-  {key:'out_for_delivery', label:'Out for Delivery', icon:'🚚', desc:'On the fleet or handed to our trucking partner.'},
-  {key:'delivered', label:'Delivered', icon:'🏠', desc:'Delivered. Thanks for the order!'},
-];
-
-let PRODUCTS = [];
-let INVENTORY = {};   // product_id -> {qty_available,...}
-let cart = {};         // product_id -> {product, qty}
-let activeCat = 'all';
-
-async function api(path, opts={}){
-  const res = await fetch(API + path, {
-    headers: {'Content-Type':'application/json'}, ...opts
-  });
-  if(!res.ok){
-    const body = await res.json().catch(()=>({detail:res.statusText}));
-    throw new Error(body.detail || 'Request failed');
-  }
-  return res.json();
-}
-
-async function checkApi(){
-  const el = document.getElementById('apiStatus');
-  try{
-    await api('/reports/dashboard');
-    el.textContent = 'Connected'; el.className = 'mono ok';
-  }catch(e){
-    el.textContent = 'API unreachable'; el.className = 'mono bad';
-  }
-}
-
-/* ============ ROUTING ============ */
-const views = ['shop','cart','confirm','track'];
-function showView(name){
-  views.forEach(v=> document.getElementById('view-'+v).classList.toggle('active', v===name));
-  document.querySelectorAll('#navTabs a').forEach(a=> a.classList.toggle('active', a.dataset.view===name));
-  if(name==='cart') renderCart();
-  if(name==='track') renderTrackDefault();
-}
-window.addEventListener('hashchange', route);
-function route(){
-  const hash = location.hash.replace('#','') || 'shop';
-  const [base, param] = hash.split('/');
-  if(views.includes(base)){
-    showView(base);
-    if(base==='track' && param) lookupOrder(param);
-  } else {
-    showView('shop');
-  }
-}
-
-/* ============ SHOP ============ */
-async function loadCatalog(){
-  const [products, inv] = await Promise.all([ api('/products?item_type=sellable'), api('/inventory') ]);
-  PRODUCTS = products;
-  INVENTORY = {};
-  inv.items.forEach(i=>{ INVENTORY[i.sku] = i; });
-  buildChips();
-  renderShop('');
-}
-
-function buildChips(){
-  const chipFilter = document.getElementById('chipFilter');
-  chipFilter.innerHTML = '';
-  const cats = ['all', ...new Set(PRODUCTS.map(p=>p.category))];
-  cats.forEach(cat=>{
-    const chip = document.createElement('button');
-    chip.className = 'chip' + (cat==='all' ? ' active' : '');
-    chip.textContent = cat === 'all' ? 'All' : cat;
-    chip.addEventListener('click', ()=>{
-      activeCat = cat;
-      chipFilter.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
-      chip.classList.add('active');
-      renderShop(document.getElementById('shopSearch').value);
-    });
-    chipFilter.appendChild(chip);
-  });
-}
-
-function renderShop(searchTerm=''){
-  searchTerm = searchTerm.trim().toLowerCase();
-  const shopBody = document.getElementById('shopBody');
-  shopBody.innerHTML = '';
-
-  const byCategory = {};
-  PRODUCTS.forEach(p=>{
-    if(activeCat !== 'all' && p.category !== activeCat) return;
-    if(searchTerm && !p.name.toLowerCase().includes(searchTerm)) return;
-    (byCategory[p.category] = byCategory[p.category] || []).push(p);
-  });
-
-  const anyVisible = Object.keys(byCategory).length > 0;
-  document.getElementById('noResults').style.display = anyVisible ? 'none' : 'block';
-
-  Object.entries(byCategory).forEach(([cat, items])=>{
-    const block = document.createElement('div');
-    block.className = 'cat-block';
-    block.innerHTML = `<div class="cat-block-head"><h3>${cat}</h3></div><div class="item-grid"></div>`;
-    const grid = block.querySelector('.item-grid');
-    items.forEach(p=>{
-      const inv = INVENTORY[p.sku];
-      const avail = inv ? inv.qty_available : null;
-      const qty = cart[p.id]?.qty || 0;
-      const row = document.createElement('div');
-      row.className = 'item-row';
-      row.innerHTML = `
-        <div class="info">
-          <span class="name">${p.name}</span>
-          <span class="wt">${p.pack_size || ''}</span>
-          ${avail !== null ? `<span class="avail ${avail<=10?'low':''}">${avail} available</span>` : ''}
-        </div>
-        <div class="stepper">
-          <button data-act="dec" aria-label="decrease">−</button>
-          <input type="number" min="0" value="${qty}" data-id="${p.id}">
-          <button data-act="inc" aria-label="increase">+</button>
-        </div>
-      `;
-      const input = row.querySelector('input');
-      row.querySelector('[data-act="dec"]').addEventListener('click', ()=>{
-        input.value = Math.max(0,(parseInt(input.value)||0)-1); updateCartFromInput(input, p);
-      });
-      row.querySelector('[data-act="inc"]').addEventListener('click', ()=>{
-        input.value = (parseInt(input.value)||0)+1; updateCartFromInput(input, p);
-      });
-      input.addEventListener('change', ()=> updateCartFromInput(input, p));
-      grid.appendChild(row);
-    });
-    shopBody.appendChild(block);
-  });
-}
-
-function updateCartFromInput(input, product){
-  const qty = Math.max(0, parseInt(input.value)||0);
-  if(qty === 0){ delete cart[product.id]; } else { cart[product.id] = {product, qty}; }
-  updateCartBadge();
-}
-document.getElementById('shopSearch').addEventListener('input', e=> renderShop(e.target.value));
-
-function updateCartBadge(){
-  const count = Object.values(cart).reduce((s,i)=>s+i.qty,0);
-  document.getElementById('cartBadge').textContent = count;
-}
-
-/* ============ CART / CHECKOUT ============ */
-function renderCart(){
-  const items = Object.values(cart);
-  const content = document.getElementById('cartContent');
-  if(items.length === 0){
-    content.innerHTML = `<div class="cart-empty">Your cart is empty. <a href="#shop">Go pick out some products →</a></div>`;
-    return;
-  }
-  const totalCases = items.reduce((s,i)=>s+i.qty,0);
-  content.innerHTML = `
-    <div class="checkout-grid">
-      <div>
-        <table class="cart-table">
-          <thead><tr><th>Item</th><th>Pack</th><th>Qty</th><th></th></tr></thead>
-          <tbody id="cartRows"></tbody>
-        </table>
-      </div>
-      <div class="panel">
-        <h3>Delivery details</h3>
-        <div class="field" id="f-name"><label>Full name *</label><input id="c-name" type="text" placeholder="Jane Rivera"><div class="err-msg">Please enter your name.</div></div>
-        <div class="row-2">
-          <div class="field" id="f-company"><label>Company</label><input id="c-company" type="text" placeholder="Rivera Foods LLC"></div>
-          <div class="field" id="f-phone"><label>Phone</label><input id="c-phone" type="tel" placeholder="(555) 555-5555"></div>
-        </div>
-        <div class="field" id="f-email"><label>Email *</label><input id="c-email" type="email" placeholder="jane@company.com"><div class="err-msg">Please enter a valid email.</div></div>
-        <div class="field" id="f-address"><label>Delivery address *</label><textarea id="c-address" rows="2" placeholder="Street, city, state, ZIP"></textarea><div class="err-msg">Please enter a delivery address.</div></div>
-        <div class="field">
-          <label>Preferred delivery window</label>
-          <select id="c-pref">
-            <option>Next available Tri-State delivery</option>
-            <option>Specific date (note below)</option>
-            <option>Will arrange freight pickup</option>
-          </select>
-        </div>
-        <div class="field"><label>Order notes</label><textarea id="c-notes" rows="2" placeholder="Split delivery, dock hours, substitutions OK, etc."></textarea></div>
-        <div class="summary-line"><span>Line items</span><span>${items.length}</span></div>
-        <div class="summary-line total"><span>Total cases requested</span><span>${totalCases}</span></div>
-        <button class="btn btn-solid" id="placeOrderBtn" style="margin-top:12px;">Place order</button>
-        <p id="orderError" style="font-size:0.78rem;color:var(--rust-deep);margin-top:8px;display:none;"></p>
-      </div>
-    </div>
-  `;
-
-  const rows = document.getElementById('cartRows');
-  items.forEach(item=>{
-    const tr = document.createElement('tr');
-    tr.innerHTML = `
-      <td>${item.product.name}</td>
-      <td class="mono" style="font-size:0.78rem;color:var(--olive-deep);">${item.product.pack_size||''}</td>
-      <td><div class="stepper"><button data-act="dec">−</button><input type="number" min="0" value="${item.qty}" style="width:44px;"><button data-act="inc">+</button></div></td>
-      <td><button class="rm">Remove</button></td>
-    `;
-    const input = tr.querySelector('input');
-    tr.querySelector('[data-act="dec"]').addEventListener('click', ()=>{ input.value = Math.max(0,(parseInt(input.value)||0)-1); applyCartRowChange(item.product, input.value); });
-    tr.querySelector('[data-act="inc"]').addEventListener('click', ()=>{ input.value = (parseInt(input.value)||0)+1; applyCartRowChange(item.product, input.value); });
-    input.addEventListener('change', ()=> applyCartRowChange(item.product, input.value));
-    tr.querySelector('.rm').addEventListener('click', ()=>{ delete cart[item.product.id]; updateCartBadge(); renderCart(); });
-    rows.appendChild(tr);
-  });
-
-  document.getElementById('placeOrderBtn').addEventListener('click', placeOrder);
-}
-
-function applyCartRowChange(product, val){
-  const qty = Math.max(0, parseInt(val)||0);
-  if(qty===0){ delete cart[product.id]; } else { cart[product.id].qty = qty; }
-  updateCartBadge(); renderCart();
-}
-
-function setFieldError(id, hasError){ document.getElementById(id).classList.toggle('error', hasError); }
-
-async function placeOrder(){
-  const name = document.getElementById('c-name').value.trim();
-  const email = document.getElementById('c-email').value.trim();
-  const address = document.getElementById('c-address').value.trim();
-  const company = document.getElementById('c-company').value.trim();
-  const phone = document.getElementById('c-phone').value.trim();
-  const pref = document.getElementById('c-pref').value;
-  const notes = document.getElementById('c-notes').value.trim();
-
-  const emailOk = /\S+@\S+\.\S+/.test(email);
-  setFieldError('f-name', name==='');
-  setFieldError('f-email', !emailOk);
-  setFieldError('f-address', address==='');
-  if(name==='' || !emailOk || address==='') return;
-
-  const btn = document.getElementById('placeOrderBtn');
-  const errEl = document.getElementById('orderError');
-  btn.disabled = true; btn.textContent = 'Placing order…'; errEl.style.display='none';
-
-  try{
-    const payload = {
-      customer: {name, email, address, company: company || null, phone: phone || null},
-      items: Object.values(cart).map(i=>({product_id: i.product.id, qty_ordered: i.qty})),
-      delivery_pref: pref,
-      notes: notes || null,
-    };
-    const order = await api('/orders', {method:'POST', body: JSON.stringify(payload)});
-    cart = {}; updateCartBadge();
-    document.getElementById('confirmOrderId').textContent = order.order_number;
-    document.getElementById('confirmTrackBtn').href = '#track/' + order.order_number;
-    location.hash = 'confirm';
-    showView('confirm');
-    loadCatalog();  // refresh stock levels shown in shop
-  }catch(e){
-    errEl.textContent = 'Could not place order: ' + e.message;
-    errEl.style.display = 'block';
-  }finally{
-    btn.disabled = false; btn.textContent = 'Place order';
-  }
-}
-
-/* ============ TRACKING ============ */
-document.getElementById('trackBtn').addEventListener('click', ()=>{
-  const id = document.getElementById('trackInput').value.trim().toUpperCase();
-  if(id) location.hash = 'track/' + id;
-});
-document.getElementById('trackInput').addEventListener('keydown', e=>{ if(e.key==='Enter') document.getElementById('trackBtn').click(); });
