+
+  @media (max-width:760px){
+    .hero-grid{grid-template-columns:1fr;}
+    .hero h1{font-size:2rem;}
+  }
+
+  /* ---------- Job list ---------- */
+  .jobs{padding:12px 0 64px;}
+  .jobs h2{font-size:1.7rem;margin-bottom:22px;}
