+  .modal-head .job-title{font-size:0.9rem;color:var(--amber-deep);font-weight:600;margin-top:4px;}
+  .close-x{
+    position:absolute;top:16px;right:18px;background:none;border:none;font-size:1.4rem;cursor:pointer;
+    color:var(--espresso-soft);line-height:1;
+  }
+
+  /* Step indicator */
+  .steps{display:flex;gap:6px;padding:14px 26px 0;flex-shrink:0;}
+  .step-dot{flex:1;height:4px;background:var(--line);border-radius:2px;}
+  .step-dot.active,.step-dot.done{background:var(--forest);}
+
+  .modal-body{padding:18px 26px 6px;overflow-y:auto;flex:1;}
+  .step-panel{display:none;}
+  .step-panel.active{display:block;}
+  .step-panel h4{font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--espresso-soft);
+    font-family:'IBM Plex Mono',monospace;margin-bottom:16px;}
+
+  label{display:block;font-size:0.82rem;font-weight:600;margin-bottom:6px;color:var(--espresso-soft);}
+  .field{margin-bottom:16px;}
+  input, select, textarea{
+    width:100%;padding:11px 13px;border:2px solid var(--line);border-radius:2px;
+    font-family:'Inter',sans-serif;font-size:0.96rem;background:#fff;color:var(--espresso);
+  }
+  input:focus, select:focus, textarea:focus{outline:none;border-color:var(--espresso);}
+  textarea{resize:vertical;min-height:80px;}
+  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
+  @media (max-width:480px){.field-row{grid-template-columns:1fr;}}
+
+  .radio-group{display:flex;gap:10px;flex-wrap:wrap;}
+  .radio-chip{
+    border:2px solid var(--line);border-radius:20px;padding:8px 16px;font-size:0.86rem;cursor:pointer;
+    user-select:none;
+  }
+  .radio-chip.selected{border-color:var(--espresso);background:var(--kraft-deep);font-weight:600;}
+
+  .review-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--line);font-size:0.9rem;}
+  .review-row .k{color:var(--espresso-soft);}
+  .review-row .v{font-weight:600;text-align:right;}
+
+  /* Sticky, always-visible footer nav — the actual Back/Next controls */
+  .modal-footer{
+    display:flex;justify-content:space-between;align-items:center;gap:12px;
+    padding:16px 26px;border-top:2px solid var(--espresso);background:var(--paper);flex-shrink:0;
+  }
+  .footer-left, .footer-right{display:flex;gap:10px;}
+  .step-label{font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:var(--espresso-soft);text-transform:uppercase;letter-spacing:0.06em;}
+
+  .form-err{
+    background:#fbeceb;border:1.5px solid var(--cranberry);color:var(--cranberry);
+    padding:9px 13px;border-radius:2px;font-size:0.84rem;margin-bottom:14px;display:none;
+  }
+
+  /* Confirmation */
+  .confirm{text-align:center;padding:30px 10px 10px;}
+  .confirm .mark-big{width:56px;height:56px;border-radius:50%;background:var(--forest);color:var(--paper);
+    display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin:0 auto 18px;}
+  .confirm h3{margin-bottom:10px;}
+  .confirm p{color:var(--espresso-soft);line-height:1.5;}
+
+  footer{border-top:2px solid var(--espresso);padding:26px 0;text-align:center;font-size:0.82rem;color:var(--espresso-soft);}
+</style>
+</head>
+<body>
+
+<header>
+  <div class="wrap bar">
+    <a class="logo" href="/">
+      <div class="mark">A</div>
+      <div class="word">American Food &amp; Beverage<span>GRASSLAND &middot; PREMIUM FOOD</span></div>
+    </a>
+    <div class="header-actions">
+      <a class="back-link" href="/">Main site</a>
+      <div class="lang-toggle">
+        <button type="button" id="langEnBtn" class="active" data-lang="en">EN</button>
+        <button type="button" id="langEsBtn" data-lang="es">ES</button>
+      </div>
+    </div>
+  </div>
+</header>
+
+<section class="hero">
+  <div class="wrap hero-grid">
+    <div>
+      <div class="eyebrow" data-i18n="eyebrow">Join our team</div>
+      <h1 data-i18n="heroTitle">Work at the plant that <em>keeps the Tri-State fed.</em></h1>
+      <p class="lede" data-i18n="heroLede">We run a 60,000 sq ft SQF-certified facility in Paterson, our own delivery
+        fleet, and next-day service across the region. We're hiring drivers, warehouse crew, packers,
+        and office staff — real jobs, straightforward pay, apply from your phone in under two minutes.</p>
+    </div>
+    <div class="stat-card">
+      <div class="stat-row"><span class="label" data-i18n="statFacility">Facility</span><span class="val">60,000 sq ft &middot; SQF certified</span></div>
+      <div class="stat-row"><span class="label" data-i18n="statLocation">Location</span><span class="val">Paterson, NJ</span></div>
+      <div class="stat-row"><span class="label" data-i18n="statFleet">Fleet</span><span class="val" data-i18n="statFleetVal">Company-owned trucks</span></div>
+      <div class="stat-row"><span class="label" data-i18n="statApply">Apply time</span><span class="val" data-i18n="statApplyVal">Under 2 minutes</span></div>
+    </div>
+  </div>
+</section>
+
+<section class="jobs">
+  <div class="wrap">
+    <h2 data-i18n="openPositions">Open positions</h2>
+    <div id="jobList"><div class="loading" data-i18n="loadingJobs">Loading open positions&hellip;</div></div>
+  </div>
+</section>
+
+<footer>
+  <div class="wrap" data-i18n="footerNote">American Food &amp; Beverage &middot; Paterson, NJ &middot; SQF Certified &middot; USDA Organic &middot; OU Kosher</div>
+</footer>
+
+<!-- ===================== Application Modal ===================== -->
+<div class="overlay" id="overlay">
+  <div class="modal">
+    <div class="modal-head">
+      <h3 data-i18n="applyTitle">Apply now</h3>
+      <div class="job-title" id="modalJobTitle"></div>
+      <button class="close-x" id="closeX" aria-label="Close">&times;</button>
+    </div>
+
+    <div class="steps">
+      <div class="step-dot active" data-step-dot="1"></div>
+      <div class="step-dot" data-step-dot="2"></div>
+      <div class="step-dot" data-step-dot="3"></div>
+    </div>
+
+    <div class="modal-body">
+      <div class="form-err" id="formErr"></div>
+
+      <!-- Step 1: contact info -->
+      <div class="step-panel active" data-step="1">
+        <h4 data-i18n="step1Head">Step 1 of 3 &mdash; Your info</h4>
+        <div class="field">
+          <label data-i18n="lblName">Full name</label>
+          <input id="f_full_name" required>
+        </div>
+        <div class="field-row">
+          <div class="field">
+            <label data-i18n="lblPhone">Phone</label>
+            <input id="f_phone" type="tel" required>
+          </div>
+          <div class="field">
+            <label data-i18n="lblEmail">Email (optional)</label>
+            <input id="f_email" type="email">
+          </div>
+        </div>
+        <div class="field">
+          <label data-i18n="lblCity">City</label>
+          <input id="f_city">
+        </div>
+      </div>
+
+      <!-- Step 2: role details -->
+      <div class="step-panel" data-step="2">
+        <h4 data-i18n="step2Head">Step 2 of 3 &mdash; Availability</h4>
+        <div class="field">
+          <label data-i18n="lblAvailability">Availability</label>
+          <div class="radio-group" id="availGroup">
+            <div class="radio-chip" data-value="Full-time" data-i18n="availFull">Full-time</div>
+            <div class="radio-chip" data-value="Part-time" data-i18n="availPart">Part-time</div>
+            <div class="radio-chip" data-value="Either" data-i18n="availEither">Either works</div>
+          </div>
+        </div>
+        <div class="field">
+          <label data-i18n="lblStart">Earliest start date</label>
+          <input id="f_start_date" type="text" placeholder="e.g. Immediately, or a specific date">
+        </div>
+        <div class="field">
+          <label data-i18n="lblExperience">Relevant experience</label>
+          <input id="f_experience" placeholder="e.g. 2 years warehouse, 5 years driving">
+        </div>
+        <div class="field" id="licenseField" style="display:none;">
+          <label data-i18n="lblLicense">Do you have a valid driver's license?</label>
+          <div class="radio-group" id="licenseGroup">
+            <div class="radio-chip" data-value="yes" data-i18n="yes">Yes</div>
+            <div class="radio-chip" data-value="no" data-i18n="no">No</div>
+          </div>
+        </div>
+      </div>
+
+      <!-- Step 3: review + message -->
+      <div class="step-panel" data-step="3">
+        <h4 data-i18n="step3Head">Step 3 of 3 &mdash; Review &amp; submit</h4>
+        <div class="field">
+          <label data-i18n="lblMessage">Anything else you'd like us to know? (optional)</label>
+          <textarea id="f_message"></textarea>
+        </div>
+        <div id="reviewBlock"></div>
+      </div>
+
+      <!-- Confirmation -->
+      <div class="step-panel" data-step="done">
+        <div class="confirm">
+          <div class="mark-big">&#10003;</div>
+          <h3 data-i18n="confirmTitle">Application received</h3>
+          <p data-i18n="confirmBody">Thanks for applying. Someone from our team will call or text you within a
+            few business days.</p>
+        </div>
+      </div>
+    </div>
+
+    <div class="modal-footer">
+      <div class="footer-left">
+        <button class="btn btn-outline" id="backBtn" data-i18n="btnBack">&larr; Back</button>
+      </div>
+      <div class="step-label" id="stepLabel">1 / 3</div>
+      <div class="footer-right">
+        <button class="btn btn-solid" id="nextBtn" data-i18n="btnNext">Next &rarr;</button>
+        <button class="btn btn-solid" id="submitBtn" style="display:none;" data-i18n="btnSubmit">Submit application</button>
+        <button class="btn btn-solid" id="doneBtn" style="display:none;" data-i18n="btnDone">Done</button>
+      </div>
+    </div>
+  </div>
+</div>
+
+<script>
+  // ---------------- i18n ----------------
+  const STRINGS = {
+    en: {
+      eyebrow: "Join our team",
+      heroTitle: 'Work at the plant that <em>keeps the Tri-State fed.</em>',
+      heroLede: "We run a 60,000 sq ft SQF-certified facility in Paterson, our own delivery fleet, and next-day service across the region. We're hiring drivers, warehouse crew, packers, and office staff — real jobs, straightforward pay, apply from your phone in under two minutes.",
+      statFacility: "Facility", statLocation: "Location", statFleet: "Fleet",
+      statFleetVal: "Company-owned trucks", statApply: "Apply time", statApplyVal: "Under 2 minutes",
+      openPositions: "Open positions", loadingJobs: "Loading open positions…",
+      noJobs: "No open positions right now — check back soon.",
+      applyTitle: "Apply now",
+      step1Head: "Step 1 of 3 — Your info", step2Head: "Step 2 of 3 — Availability",
+      step3Head: "Step 3 of 3 — Review & submit",
+      lblName: "Full name", lblPhone: "Phone", lblEmail: "Email (optional)", lblCity: "City",
+      lblAvailability: "Availability", lblStart: "Earliest start date", lblExperience: "Relevant experience",
+      lblLicense: "Do you have a valid driver's license?", lblMessage: "Anything else you'd like us to know? (optional)",
+      availFull: "Full-time", availPart: "Part-time", availEither: "Either works",
+      yes: "Yes", no: "No",
+      confirmTitle: "Application received",
+      confirmBody: "Thanks for applying. Someone from our team will call or text you within a few business days.",
+      btnBack: "← Back", btnNext: "Next →", btnSubmit: "Submit application", btnDone: "Done",
+      errName: "Please enter your name.", errPhone: "Please enter a phone number.",
+      errSubmit: "Something went wrong submitting your application. Please try again.",
+      apply: "Apply", perHour: "", footerNote: "American Food & Beverage · Paterson, NJ · SQF Certified · USDA Organic · OU Kosher"
+    },
+    es: {
+      eyebrow: "Únete a nuestro equipo",
+      heroTitle: 'Trabaja en la planta que <em>alimenta a la región Tri-State.</em>',
+      heroLede: "Operamos una instalación de 60,000 pies cuadrados certificada SQF en Paterson, nuestra propia flota de entrega y servicio al día siguiente en toda la región. Estamos contratando conductores, personal de almacén, empacadores y personal de oficina — trabajos reales, pago claro, aplica desde tu teléfono en menos de dos minutos.",
+      statFacility: "Instalación", statLocation: "Ubicación", statFleet: "Flota",
+      statFleetVal: "Camiones propios", statApply: "Tiempo de solicitud", statApplyVal: "Menos de 2 minutos",
+      openPositions: "Posiciones abiertas", loadingJobs: "Cargando posiciones abiertas…",
+      noJobs: "No hay posiciones abiertas por ahora — vuelve pronto.",
+      applyTitle: "Aplica ahora",
+      step1Head: "Paso 1 de 3 — Tu información", step2Head: "Paso 2 de 3 — Disponibilidad",
+      step3Head: "Paso 3 de 3 — Revisar y enviar",
+      lblName: "Nombre completo", lblPhone: "Teléfono", lblEmail: "Correo electrónico (opcional)", lblCity: "Ciudad",
+      lblAvailability: "Disponibilidad", lblStart: "Fecha de inicio más próxima", lblExperience: "Experiencia relevante",
+      lblLicense: "¿Tienes licencia de conducir válida?", lblMessage: "¿Algo más que quieras que sepamos? (opcional)",
+      availFull: "Tiempo completo", availPart: "Medio tiempo", availEither: "Cualquiera",
+      yes: "Sí", no: "No",
+      confirmTitle: "Solicitud recibida",
+      confirmBody: "Gracias por aplicar. Alguien de nuestro equipo te llamará o enviará un mensaje en unos días hábiles.",
+      btnBack: "← Atrás", btnNext: "Siguiente →", btnSubmit: "Enviar solicitud", btnDone: "Listo",
+      errName: "Por favor ingresa tu nombre.", errPhone: "Por favor ingresa un número de teléfono.",
+      errSubmit: "Algo salió mal al enviar tu solicitud. Por favor intenta de nuevo.",
+      apply: "Aplicar", perHour: "", footerNote: "American Food & Beverage · Paterson, NJ · Certificado SQF · Orgánico USDA · Kosher OU"
+    }
+  };
+  let currentLang = 'en';
+
+  function applyI18n() {
+    const s = STRINGS[currentLang];
+    document.querySelectorAll('[data-i18n]').forEach(el => {
+      const key = el.getAttribute('data-i18n');
+      if (s[key] !== undefined) el.innerHTML = s[key];
+    });
+    document.getElementById('langEnBtn').classList.toggle('active', currentLang === 'en');
+    document.getElementById('langEsBtn').classList.toggle('active', currentLang === 'es');
+    renderJobs(); // re-render job cards with translated "Apply" button
+  }
+  document.getElementById('langEnBtn').addEventListener('click', () => { currentLang = 'en'; applyI18n(); });
+  document.getElementById('langEsBtn').addEventListener('click', () => { currentLang = 'es'; applyI18n(); });
+
+  // ---------------- Job list ----------------
+  let jobsData = [];
+
+  async function loadJobs() {
+    try {
+      const res = await fetch('/careers/jobs');
+      jobsData = await res.json();
+      renderJobs();
+    } catch (e) {
+      document.getElementById('jobList').innerHTML = `<div class="empty">${STRINGS[currentLang].noJobs}</div>`;
+    }
+  }
+
+  function renderJobs() {
+    const container = document.getElementById('jobList');
+    const s = STRINGS[currentLang];
+    if (!jobsData.length) {
+      container.innerHTML = `<div class="empty">${s.noJobs}</div>`;
+      return;
+    }
+    container.innerHTML = jobsData.map(job => `
+      <div class="job-card">
+        <div class="job-info">
+          <h3>${escapeHtml(job.title)}</h3>
+          <div class="job-meta">
+            ${job.department ? `<span>${escapeHtml(job.department)}</span>` : ''}
+            ${job.shift ? `<span>${escapeHtml(job.shift)}</span>` : ''}
+            ${job.pay_range ? `<span class="pay-pill">${escapeHtml(job.pay_range)}</span>` : ''}
+          </div>
+          <div class="job-summary">${escapeHtml(job.summary || '')}</div>
+        </div>
+        <button class="btn btn-solid" onclick="openModal(${job.id})">${s.apply}</button>
+      </div>
+    `).join('');
+  }
+
+  function escapeHtml(str) {
+    const d = document.createElement('div');
+    d.textContent = str || '';
+    return d.innerHTML;
+  }
+
+  loadJobs();
+
+  // ---------------- Multi-step application modal ----------------
+  const overlay = document.getElementById('overlay');
+  const TOTAL_STEPS = 3;
+  let step = 1;
+  let currentJob = null;
+  let selectedAvail = null;
+  let selectedLicense = null;
+
+  function openModal(jobId) {
+    currentJob = jobsData.find(j => j.id === jobId);
+    if (!currentJob) return;
+    document.getElementById('modalJobTitle').textContent = currentJob.title;
+    document.getElementById('licenseField').style.display =
+      /driver/i.test(currentJob.title) ? 'block' : 'none';
+    step = 1;
+    selectedAvail = null;
+    selectedLicense = null;
+    document.querySelectorAll('.radio-chip').forEach(c => c.classList.remove('selected'));
+    ['f_full_name','f_phone','f_email','f_city','f_start_date','f_experience','f_message'].forEach(id => {
+      document.getElementById(id).value = '';
+    });
+    renderStep();
+    overlay.classList.add('open');
+  }
+
+  function closeModal() {
+    overlay.classList.remove('open');
+  }
+  document.getElementById('closeX').addEventListener('click', closeModal);
+  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
+
+  document.querySelectorAll('#availGroup .radio-chip').forEach(chip => {
+    chip.addEventListener('click', () => {
+      document.querySelectorAll('#availGroup .radio-chip').forEach(c => c.classList.remove('selected'));
+      chip.classList.add('selected');
+      selectedAvail = chip.getAttribute('data-value');
+    });
+  });
+  document.querySelectorAll('#licenseGroup .radio-chip').forEach(chip => {
+    chip.addEventListener('click', () => {
+      document.querySelectorAll('#licenseGroup .radio-chip').forEach(c => c.classList.remove('selected'));
+      chip.classList.add('selected');
+      selectedLicense = chip.getAttribute('data-value');
+    });
+  });
+
+  function renderStep() {
+    document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'));
+    document.querySelector(`.step-panel[data-step="${step === 'done' ? 'done' : step}"]`).classList.add('active');
+    document.querySelectorAll('.step-dot').forEach(dot => {
+      const dStep = parseInt(dot.getAttribute('data-step-dot'));
+      dot.classList.toggle('active', dStep === step);
+      dot.classList.toggle('done', typeof step === 'number' && dStep < step);
+    });
+    document.getElementById('formErr').style.display = 'none';
+
+    const backBtn = document.getElementById('backBtn');
+    const nextBtn = document.getElementById('nextBtn');
+    const submitBtn = document.getElementById('submitBtn');
+    const doneBtn = document.getElementById('doneBtn');
+    const stepLabel = document.getElementById('stepLabel');
+
+    if (step === 'done') {
+      backBtn.style.visibility = 'hidden';
+      nextBtn.style.display = 'none';
+      submitBtn.style.display = 'none';
+      doneBtn.style.display = 'inline-flex';
+      stepLabel.textContent = '';
+      return;
+    }
+
+    doneBtn.style.display = 'none';
+    stepLabel.textContent = `${step} / ${TOTAL_STEPS}`;
+    // Back is always visible; disabled (not hidden) on step 1 so the control
+    // never disappears — it's just inert until there's somewhere to go back to.
+    backBtn.style.visibility = 'visible';
+    backBtn.disabled = (step === 1);
+    backBtn.style.opacity = (step === 1) ? '0.4' : '1';
+
+    if (step === TOTAL_STEPS) {
+      nextBtn.style.display = 'none';
+      submitBtn.style.display = 'inline-flex';
+      renderReview();
+    } else {
+      nextBtn.style.display = 'inline-flex';
+      submitBtn.style.display = 'none';
+    }
+  }
+
+  function renderReview() {
+    const s = STRINGS[currentLang];
+    const rows = [
+      [s.lblName, document.getElementById('f_full_name').value],
+      [s.lblPhone, document.getElementById('f_phone').value],
+      [s.lblEmail, document.getElementById('f_email').value || '—'],
+      [s.lblCity, document.getElementById('f_city').value || '—'],
+      [s.lblAvailability, selectedAvail || '—'],
+      [s.lblStart, document.getElementById('f_start_date').value || '—'],
+      [s.lblExperience, document.getElementById('f_experience').value || '—'],
+    ];
+    if (document.getElementById('licenseField').style.display !== 'none') {
+      rows.push([s.lblLicense, selectedLicense === 'yes' ? s.yes : (selectedLicense === 'no' ? s.no : '—')]);
+    }
+    document.getElementById('reviewBlock').innerHTML = rows.map(([k, v]) => `
+      <div class="review-row"><span class="k">${escapeHtml(k)}</span><span class="v">${escapeHtml(v)}</span></div>
+    `).join('');
+  }
+
+  function showError(msg) {
+    const box = document.getElementById('formErr');
+    box.textContent = msg;
+    box.style.display = 'block';
+  }
+
+  function validateStep1() {
+    const s = STRINGS[currentLang];
+    if (!document.getElementById('f_full_name').value.trim()) { showError(s.errName); return false; }
+    if (!document.getElementById('f_phone').value.trim()) { showError(s.errPhone); return false; }
+    return true;
+  }
+
+  document.getElementById('backBtn').addEventListener('click', () => {
+    if (step === 1 || step === 'done') return;
+    step -= 1;
+    renderStep();
+  });
+
+  document.getElementById('nextBtn').addEventListener('click', () => {
+    if (step === 1 && !validateStep1()) return;
+    step += 1;
+    renderStep();
+  });
+
+  document.getElementById('submitBtn').addEventListener('click', async () => {
+    const s = STRINGS[currentLang];
+    const submitBtn = document.getElementById('submitBtn');
+    submitBtn.disabled = true;
+    const payload = {
+      job_id: currentJob.id,
+      full_name: document.getElementById('f_full_name').value.trim(),
+      phone: document.getElementById('f_phone').value.trim(),
+      email: document.getElementById('f_email').value.trim() || null,
+      city: document.getElementById('f_city').value.trim() || null,
+      availability: selectedAvail,
+      start_date: document.getElementById('f_start_date').value.trim() || null,
+      experience_years: document.getElementById('f_experience').value.trim() || null,
+      has_license: selectedLicense === 'yes' ? true : (selectedLicense === 'no' ? false : null),
+      language_pref: currentLang,
+      message: document.getElementById('f_message').value.trim() || null,
+    };
+    try {
+      const res = await fetch('/careers/apply', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json'},
+        body: JSON.stringify(payload)
+      });
+      if (!res.ok) {
+        const data = await res.json().catch(() => ({}));
+        showError(data.detail || s.errSubmit);
+        submitBtn.disabled = false;
+        return;
+      }
+      step = 'done';
+      renderStep();
+    } catch (e) {
+      showError(s.errSubmit);
+      submitBtn.disabled = false;
+    }
+  });
+
+  document.getElementById('doneBtn').addEventListener('click', closeModal);
+</script>
+
+</body>
+</html>
