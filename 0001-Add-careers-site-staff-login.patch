+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from .. import models, schemas
+from ..auth import get_current_staff, require_role
+from ..database import get_db
+
+router = APIRouter(prefix="/careers", tags=["careers"])
+
+
+def _job_out(job: models.JobPosting) -> schemas.JobPostingOut:
+    return schemas.JobPostingOut(
+        id=job.id, title=job.title, department=job.department, shift=job.shift,
+        pay_range=job.pay_range, location=job.location, summary=job.summary,
+        requirements=job.requirements, status=job.status, created_at=job.created_at,
+        application_count=len(job.applications),
+    )
+
+
+# ---------- Public ----------
+@router.get("/jobs", response_model=list[schemas.JobPostingOut])
+def list_open_jobs(db: Session = Depends(get_db)):
+    """Public — only open postings, for the careers page."""
+    jobs = (
+        db.query(models.JobPosting)
+        .filter(models.JobPosting.status == models.JobPostingStatus.open)
+        .order_by(models.JobPosting.created_at.desc())
+        .all()
+    )
+    return [_job_out(j) for j in jobs]
+
+
+@router.post("/apply", response_model=schemas.JobApplicationOut)
+def apply(payload: schemas.JobApplicationCreate, db: Session = Depends(get_db)):
+    job = db.query(models.JobPosting).get(payload.job_id)
+    if not job or job.status != models.JobPostingStatus.open:
+        raise HTTPException(400, "This position is no longer accepting applications")
+
+    app_ = models.JobApplication(**payload.model_dump())
+    db.add(app_)
+    db.commit()
+    db.refresh(app_)
+    return schemas.JobApplicationOut(
+        id=app_.id, job_id=app_.job_id, job_title=job.title, full_name=app_.full_name,
+        phone=app_.phone, email=app_.email, city=app_.city, availability=app_.availability,
+        start_date=app_.start_date, experience_years=app_.experience_years,
+        has_license=app_.has_license, language_pref=app_.language_pref, message=app_.message,
+        status=app_.status, reviewer_notes=app_.reviewer_notes, applied_at=app_.applied_at,
+    )
+
+
+# ---------- Staff (manager/admin) ----------
+@router.get("/jobs/all", response_model=list[schemas.JobPostingOut])
+def list_all_jobs(staff=Depends(get_current_staff), db: Session = Depends(get_db)):
+    jobs = db.query(models.JobPosting).order_by(models.JobPosting.created_at.desc()).all()
+    return [_job_out(j) for j in jobs]
+
+
+@router.post("/jobs", response_model=schemas.JobPostingOut)
+def create_job(
+    payload: schemas.JobPostingCreate,
+    staff=Depends(require_role("admin", "manager")),
+    db: Session = Depends(get_db),
+):
+    job = models.JobPosting(**payload.model_dump())
+    db.add(job)
+    db.commit()
+    db.refresh(job)
+    return _job_out(job)
+
+
+@router.patch("/jobs/{job_id}", response_model=schemas.JobPostingOut)
+def update_job(
+    job_id: int,
+    payload: schemas.JobPostingUpdate,
+    staff=Depends(require_role("admin", "manager")),
+    db: Session = Depends(get_db),
+):
+    job = db.query(models.JobPosting).get(job_id)
+    if not job:
+        raise HTTPException(404, "Job posting not found")
+    for field, value in payload.model_dump(exclude_unset=True).items():
+        setattr(job, field, value)
+    db.commit()
+    db.refresh(job)
+    return _job_out(job)
+
+
+@router.get("/applications", response_model=list[schemas.JobApplicationOut])
+def list_applications(staff=Depends(get_current_staff), db: Session = Depends(get_db)):
+    apps = db.query(models.JobApplication).order_by(models.JobApplication.applied_at.desc()).all()
+    return [
+        schemas.JobApplicationOut(
+            id=a.id, job_id=a.job_id, job_title=a.job.title, full_name=a.full_name,
+            phone=a.phone, email=a.email, city=a.city, availability=a.availability,
+            start_date=a.start_date, experience_years=a.experience_years,
+            has_license=a.has_license, language_pref=a.language_pref, message=a.message,
+            status=a.status, reviewer_notes=a.reviewer_notes, applied_at=a.applied_at,
+        )
+        for a in apps
+    ]
+
+
+@router.patch("/applications/{application_id}", response_model=schemas.JobApplicationOut)
+def update_application_status(
+    application_id: int,
+    payload: schemas.JobApplicationStatusUpdate,
+    staff=Depends(get_current_staff),
+    db: Session = Depends(get_db),
+):
+    a = db.query(models.JobApplication).get(application_id)
+    if not a:
+        raise HTTPException(404, "Application not found")
+    a.status = payload.status
+    if payload.reviewer_notes is not None:
+        a.reviewer_notes = payload.reviewer_notes
+    db.commit()
+    db.refresh(a)
+    return schemas.JobApplicationOut(
+        id=a.id, job_id=a.job_id, job_title=a.job.title, full_name=a.full_name,
+        phone=a.phone, email=a.email, city=a.city, availability=a.availability,
+        start_date=a.start_date, experience_years=a.experience_years,
+        has_license=a.has_license, language_pref=a.language_pref, message=a.message,
+        status=a.status, reviewer_notes=a.reviewer_notes, applied_at=a.applied_at,
+    )
