-            "count": len(low_stock),
-        })
-
-    # Orders stuck in a non-terminal status for more than 48 hours with no progress
-    stale_cutoff = datetime.utcnow() - timedelta(hours=48)
-    stuck_orders = db.query(models.Order).filter(
